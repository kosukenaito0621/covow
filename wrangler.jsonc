{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "covow",
  "main": "./src/server/index.ts",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  // 毎日 3:00（日本時間）に、期限の過ぎた体験版のアカウントとデータを消す（Cron は UTC で書く）
  "triggers": { "crons": ["0 18 * * *"] },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // 開発用（ローカル）。本番は env.production で別の DB を使う。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "covow-db-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "production": {
      // 環境の名前を付けない（URL を https://covow.<サブドメイン>.workers.dev にする）
      "name": "covow",
      "triggers": { "crons": ["0 18 * * *"] },
      // 本番の D1（2026-10-26 作成・APAC）
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "covow-db",
          "database_id": "4b95af0b-3917-428f-9597-b45fc23555ed",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
