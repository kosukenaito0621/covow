{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@server/*": ["./src/server/*"],
      "@app/*": ["./src/app/*"],
      // BudouX は本体（index）が Node 用の部品まで読み込むので、文節の解析と日本語のモデルだけを直接使う
      "@budoux/parser": ["./node_modules/budoux/module/parser"],
      "@budoux/ja": ["./node_modules/budoux/module/data/models/ja"]
    }
  }
}
